{
  "debug": false,
  "status_refresh": 5.0,
  "session_auto_save": true,
  "session_auto_save_interval": 1.0,
  "teammate_loop_limit": 1000,
  "poll_interval": 5,
  "idle_timeout": 36000,
  "compact_tool_result_ratio_threshold": 0.6,
  "compact_tool_result_persist_single_content_threshhold": 30000,
  "compact_tool_result_persist_fullsize_threshhold": 200000,
  "compact_history_ratio_threshold": 0.75,
  "compact_history_keep_latest_message_num": 10,
  "compact_history_keep_original_message_num": 10,
  "dangerous_command_policy": "confirm",
  "dangerous_command_patterns_override": null,
  "dangerous_command_patterns_extra": [],
  "dangerous_command_timeout": 1800,
  "model_params": {
    "my-custom-model": {
      "context_window": 128000,
      "output_max": 4096,
      "pricing": { "input": 0.27, "output": 1.10, "cache_read": 0.07, "cache_creation": 0.34 }
    }
  },
  "model_router": {
    "enabled": false,
    "lead": null,
    "default": null,
    "by_role": {
      "frontend": "claude-sonnet-4",
      "backend": "claude-opus-4"
    },
    "by_keyword": [
      { "keywords": ["test", "unit test", "refactor"], "model": "deepseek-flash" }
    ],
    "classifier": {
      "model": "deepseek-flash",
      "categories": [
        { "name": "trivial", "model": "deepseek-flash", "description": "simple mechanical edits, typos, formatting, small config changes" },
        { "name": "complex", "model": "claude-opus-4", "description": "complex architecture, debugging, security-sensitive or large-scale work" }
      ]
    }
  }
}
